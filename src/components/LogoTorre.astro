---
// Logo de la cabecera: versión vectorial del avatar, con la torre más cerca
// para que se lea bien a 44 px. La portada sigue usando la ilustración PNG.
interface Props {
  class?: string;
  size?: number;
}
const { class: clase, size = 44 } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width={size} height={size} class={clase} aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="lt-cielo" cx="48%" cy="85%" r="75%">
      <stop offset="0" stop-color="#5a1426"/>
      <stop offset="0.55" stop-color="#26091a"/>
      <stop offset="1" stop-color="#110610"/>
    </radialGradient>
    <linearGradient id="lt-colina" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9a1840"/>
      <stop offset="1" stop-color="#3a0716"/>
    </linearGradient>
    <linearGradient id="lt-luz" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe39a"/>
      <stop offset="1" stop-color="#f3a531"/>
    </linearGradient>
    <filter id="lt-halo" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5"/>
    </filter>
    <filter id="lt-brillo" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.2"/>
    </filter>
    <clipPath id="lt-circulo"><circle cx="50" cy="50" r="46"/></clipPath>
  </defs>
  <g clip-path="url(#lt-circulo)">
    <rect width="100" height="100" fill="url(#lt-cielo)"/>
    <circle cx="19" cy="32" r="0.9" fill="#f7cf7a"/>
    <circle cx="31" cy="15" r="0.7" fill="#f7cf7a"/>
    <circle cx="87" cy="60" r="0.8" fill="#f7cf7a"/>
    <!-- halo cálido tras la torre y la estrella -->
    <path d="M27 30h38l6 58H21z" fill="#f08a2c" opacity="0.85" filter="url(#lt-halo)"/>
    <circle cx="75" cy="23" r="9" fill="#f5b042" opacity="0.55" filter="url(#lt-halo)"/>
    <!-- torre: cara izquierda en sombra, derecha iluminada -->
    <path d="M27 22h7.5v8h3.2v-8h7.5v8H46V40H27z" fill="#650a26"/>
    <path d="M46 30h1.1v-8h7.5v8h3.2v-8h7.5V40H46z" fill="#a3163f"/>
    <path d="M30 40h16v48H25z" fill="#650a26"/>
    <path d="M46 40h16l5 48H46z" fill="#a3163f"/>
    <rect x="27" y="39.3" width="38.3" height="1.4" fill="#d9466a"/>
    <!-- ventana y puerta encendidas -->
    <path d="M42 61v-6a4 4 0 0 1 8 0v6z" fill="#f5b042" filter="url(#lt-brillo)" opacity="0.8"/>
    <path d="M42 61v-6a4 4 0 0 1 8 0v6z" fill="url(#lt-luz)"/>
    <path d="M41.5 88v-9a4.5 4.5 0 0 1 9 0v9z" fill="#f5b042" filter="url(#lt-brillo)" opacity="0.8"/>
    <path d="M41.5 88v-9a4.5 4.5 0 0 1 9 0v9z" fill="url(#lt-luz)"/>
    <!-- colina -->
    <path d="M0 90Q50 76 100 90V100H0z" fill="url(#lt-colina)"/>
    <path d="M10 88Q50 77 90 88" fill="none" stroke="#f3a531" stroke-width="0.9" opacity="0.85"/>
    <!-- estrellas -->
    <path d="M75 14L77 21 84 23 77 25 75 32 73 25 66 23 73 21z" fill="#ffd36b"/>
    <path d="M84 36L84.8 39.2 88 40 84.8 40.8 84 44 83.2 40.8 80 40 83.2 39.2z" fill="#ffd36b"/>
  </g>
  <circle cx="50" cy="50" r="46" fill="none" stroke="#f0b13f" stroke-width="3"/>
</svg>
