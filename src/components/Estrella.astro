---
interface Props {
  tam?: number;
  encendida?: boolean;
}
const { tam = 28, encendida = true } = Astro.props;
---

<svg
  class:list={['estrella', { 'estrella--apagada': !encendida }]}
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path
    d="M12 0c.9 6.6 4.8 10.5 12 12-7.2 1.5-11.1 5.4-12 12-.9-6.6-4.8-10.5-12-12C7.2 10.5 11.1 6.6 12 0Z"
    fill="currentColor"></path>
</svg>

<style>
  .estrella {
    color: var(--oro);
    filter: drop-shadow(0 0 6px rgba(240, 177, 63, 0.65));
    flex-shrink: 0;
  }
  .estrella--apagada {
    color: var(--texto-3);
    filter: none;
    opacity: 0.6;
  }
</style>
