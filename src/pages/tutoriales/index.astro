---
import Base from '../../layouts/Base.astro';
import Estrella from '../../components/Estrella.astro';
import { seriesConTutoriales, urlTutorial } from '../../lib/tutoriales';

// Cada ficha de src/content/series/ es un bloque; sus tutoriales salen de src/content/tutoriales/<serie>/.
const bloques = await seriesConTutoriales();
const duracion = (min: number) =>
  min < 60 ? `${min} min` : `${Math.floor(min / 60)} h${min % 60 ? ` ${min % 60} min` : ''}`;
---

<Base
  titulo="Tutoriales"
  descripcion="Guías cortas y prácticas para poner en marcha herramientas de IA y automatización en tu trabajo."
>
  <section class="contenedor cabeza">
    <span class="etiqueta">Tutoriales</span>
    <h1>Guías cortas para ponerte en marcha</h1>
    <p class="cabeza__entrada">
      Los talleres son un recorrido completo. Los tutoriales son piezas sueltas: cada uno resuelve una cosa
      concreta y lo puedes hacer en una sentada. Empieza por el primero de cada serie o salta al que necesites.
    </p>
  </section>

  {
    bloques.map(({ serie, tutoriales }) => {
      const minutos = tutoriales.reduce((suma, t) => suma + t.data.minutos, 0);
      return (
        <section class="contenedor serie" id={serie.id} aria-labelledby={`titulo-${serie.id}`}>
          <header class="serie__cabeza">
            <span class="etiqueta">{serie.data.etiqueta}</span>
            <h2 id={`titulo-${serie.id}`}>{serie.data.titulo}</h2>
            <p class="serie__descripcion">{serie.data.descripcion}</p>
            <p class="serie__datos">
              {tutoriales.length} tutoriales · {duracion(minutos)} en total
            </p>
          </header>
          <ol class="lista">
            {tutoriales.map((t, i) => (
              <li>
                <a class="tarjeta lista__tarjeta" href={urlTutorial(t)}>
                  <span class="lista__n" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="lista__texto">
                    <span class="lista__titulo">{t.data.titulo}</span>
                    <span class="lista__resumen">{t.data.resumen}</span>
                    <span class="lista__datos">
                      <Estrella tam={14} /> {t.data.nivel} · {t.data.minutos} min
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</Base>

<style>
  .cabeza {
    padding-top: 3rem;
  }

  .cabeza__entrada {
    max-width: var(--ancho-texto);
    font-size: 1.15rem;
    color: var(--texto-2);
  }

  .serie {
    padding-top: 3rem;
    scroll-margin-top: 5rem;
  }

  .serie__cabeza {
    max-width: var(--ancho-texto);
    margin-bottom: 1.75rem;
  }

  .serie__descripcion {
    color: var(--texto-2);
  }

  .serie__datos {
    font-size: 0.92rem;
    color: var(--texto-3);
    margin: 0;
  }

  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .lista {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lista__tarjeta {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--texto);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .lista__tarjeta:hover {
    border-color: var(--linea-fuerte);
    color: var(--texto);
    transform: translateY(-2px);
  }

  .lista__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--linea-fuerte);
    color: var(--oro);
    font-family: var(--f-titulo);
    font-weight: 600;
  }

  .lista__texto {
    display: grid;
    gap: 0.35rem;
  }

  .lista__titulo {
    font-family: var(--f-titulo);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .lista__resumen {
    color: var(--texto-2);
    font-size: 0.98rem;
  }

  .lista__datos {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--texto-3);
  }
</style>
