---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Progreso from '../../../components/Progreso.astro';
import Prosa from '../../../components/Prosa.astro';
import {
  leccionesDe,
  slugModulo,
  talleresDisponibles,
  urlModulo,
  urlTaller,
  type Leccion,
  type TallerDisponible,
} from '../../../lib/talleres';

export async function getStaticPaths() {
  const rutas = [];
  for (const taller of await talleresDisponibles()) {
    const modulos = await leccionesDe(taller.id);
    rutas.push(
      ...modulos.map((leccion, i) => ({
        params: { taller: taller.id, modulo: slugModulo(leccion) },
        props: { taller, leccion, anterior: modulos[i - 1], siguiente: modulos[i + 1], total: modulos.length },
      })),
    );
  }
  return rutas;
}

const { taller, leccion, anterior, siguiente, total } = Astro.props as {
  taller: TallerDisponible;
  leccion: Leccion;
  anterior?: Leccion;
  siguiente?: Leccion;
  total: number;
};
const { Content } = await render(leccion);
---

<Base titulo={`Módulo ${leccion.data.modulo}. ${leccion.data.titulo}`} descripcion={leccion.data.resumen}>
  <div class="contenedor leccion">
    <nav class="miga" aria-label="Migas">
      <a href={urlTaller(taller.id)}>{taller.data.titulo}</a>
    </nav>

    <header class="leccion__cabeza">
      <span class="etiqueta">Módulo {leccion.data.modulo} de {total} · {leccion.data.minutos} min</span>
      <h1>{leccion.data.titulo}</h1>
      <p class="leccion__resumen">{leccion.data.resumen}</p>
      <Progreso taller={taller.id} total={total} />
    </header>

    <Prosa>
      <Content />
    </Prosa>

    <div class="completar tarjeta">
      <p>¿Has terminado este módulo?</p>
      <button class="boton" type="button" data-completar data-taller={taller.id} data-modulo={leccion.data.modulo} aria-pressed="false">
        Marcar como completado
      </button>
    </div>

    <nav class="pasos" aria-label="Módulos">
      {
        anterior ? (
          <a class="pasos__enlace" href={urlModulo(anterior)}>
            <span>← Anterior</span>
            <strong>{anterior.data.titulo}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        siguiente ? (
          <a class="pasos__enlace pasos__enlace--sig" href={urlModulo(siguiente)}>
            <span>Siguiente →</span>
            <strong>{siguiente.data.titulo}</strong>
          </a>
        ) : (
          <a class="pasos__enlace pasos__enlace--sig" href={urlTaller(taller.id)}>
            <span>Fin del taller →</span>
            <strong>Volver al recorrido</strong>
          </a>
        )
      }
    </nav>
  </div>
</Base>

<script>
  import { leerHechos, marcar } from '../../../lib/progreso';

  const boton = document.querySelector<HTMLButtonElement>('[data-completar]');
  if (boton) {
    const taller = boton.dataset.taller ?? '';
    const modulo = Number(boton.dataset.modulo);
    const pintar = () => {
      const hecho = leerHechos(taller).includes(modulo);
      boton.setAttribute('aria-pressed', String(hecho));
      boton.textContent = hecho ? '✓ Completado' : 'Marcar como completado';
      boton.classList.toggle('boton--secundario', hecho);
    };
    boton.addEventListener('click', () => {
      marcar(taller, modulo, boton.getAttribute('aria-pressed') !== 'true');
      pintar();
    });
    pintar();
  }
</script>

<style>
  .leccion {
    max-width: calc(var(--ancho-texto) + 3rem);
    padding-top: 2.5rem;
  }

  .miga a {
    font-size: 0.92rem;
    color: var(--texto-2);
    text-decoration: none;
  }

  .miga a::before {
    content: '← ';
  }

  .leccion__cabeza {
    margin: 1.5rem 0 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--linea);
  }

  .leccion__resumen {
    font-size: 1.15rem;
    color: var(--texto-2);
    margin-bottom: 1.5rem;
  }

  .completar {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .completar p {
    margin: 0;
    font-weight: 700;
  }

  .pasos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .pasos__enlace {
    display: grid;
    gap: 0.2rem;
    padding: 1rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    color: var(--texto);
  }

  .pasos__enlace:hover {
    border-color: var(--linea-fuerte);
    background: rgba(240, 177, 63, 0.05);
  }

  .pasos__enlace span {
    font-size: 0.85rem;
    color: var(--texto-3);
  }

  .pasos__enlace--sig {
    text-align: right;
  }

  @media (max-width: 520px) {
    .pasos {
      grid-template-columns: 1fr;
    }
    .pasos__enlace--sig {
      text-align: left;
    }
  }
</style>
