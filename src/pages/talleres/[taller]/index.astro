---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Progreso from '../../../components/Progreso.astro';
import Estrella from '../../../components/Estrella.astro';
import { leccionesDe, talleresDisponibles, urlModulo, type TallerDisponible } from '../../../lib/talleres';

export async function getStaticPaths() {
  return (await talleresDisponibles()).map((taller) => ({ params: { taller: taller.id }, props: { taller } }));
}

const { taller } = Astro.props as { taller: TallerDisponible };
const ficha = taller.data;
const modulos = await leccionesDe(taller.id);
const minutos = modulos.reduce((suma, m) => suma + m.data.minutos, 0);
const listas = [
  { titulo: 'Al terminar te llevas', items: ficha.recursos },
  { titulo: 'Material de referencia', items: ficha.referencia ?? [] },
].filter((lista) => lista.items.length > 0);
---

<Base titulo={ficha.titulo} descripcion={ficha.descripcion}>
  <section class="cabeza">
    <Image src={ficha.portada} alt="" widths={[800, 1600]} sizes="100vw" class="cabeza__fondo" loading="eager" />
    <div class="contenedor cabeza__contenido">
      <a class="miga" href="/#mapa">← El mapa de Galatar</a>
      <span class="etiqueta">Taller {ficha.orden} · {ficha.etiqueta}</span>
      <h1>{ficha.titulo}</h1>
      <p class="cabeza__entrada">{ficha.entrada}</p>
      <ul class="datos" aria-label="Datos del taller">
        <li><strong>Nivel</strong> {ficha.nivel}</li>
        <li><strong>Duración</strong> {minutos} minutos</li>
        <li><strong>Incluye</strong> Recursos descargables</li>
      </ul>
      <a class="boton" href={urlModulo(modulos[0])}>Empezar el módulo {modulos[0].data.modulo}</a>
    </div>
  </section>

  <div class="contenedor cuerpo">
    <section class="recorrido" aria-labelledby="titulo-recorrido">
      <h2 id="titulo-recorrido">Tu recorrido de aprendizaje</h2>
      <div class="tarjeta recorrido__caja">
        <Progreso taller={taller.id} total={modulos.length} />
        <ol class="modulos" data-modulos data-taller={taller.id}>
          {
            modulos.map((m) => (
              <li data-modulo={m.data.modulo}>
                <a href={urlModulo(m)}>
                  <span class="modulos__marca" aria-hidden="true" />
                  <span class="modulos__texto">
                    <span class="modulos__titulo">
                      Módulo {m.data.modulo}. {m.data.titulo}
                    </span>
                    <span class="modulos__resumen">{m.data.resumen}</span>
                  </span>
                  <span class="modulos__min">{m.data.minutos} min</span>
                  <span class="sr-only" data-estado>Pendiente</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <aside class="lateral">
      {
        listas.map((lista) => (
          <section class="tarjeta">
            <h2 class="lateral__titulo">{lista.titulo}</h2>
            <ul class="recursos">
              {lista.items.map((r) => (
                <li>
                  <Estrella tam={18} />
                  <span>
                    <strong>
                      {r.archivo ? (
                        <a href={`/descargas/${r.archivo}`} download>
                          {r.titulo}
                        </a>
                      ) : (
                        r.titulo
                      )}
                    </strong>
                    <span class="recursos__detalle">
                      {r.archivo ? `${r.detalle} · Descargar (${r.archivo.split('.').pop()})` : r.detalle}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
            {lista.items.some((r) => !r.archivo) && (
              <p class="aviso">Prototipo: las descargas que faltan están en preparación.</p>
            )}
          </section>
        ))
      }

      <section class="tarjeta">
        <h2 class="lateral__titulo">Cómo está pensado</h2>
        <p class="lateral__texto">{ficha.enfoque}</p>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { leerHechos } from '../../../lib/progreso';

  function marcarLista() {
    const lista = document.querySelector<HTMLElement>('[data-modulos]');
    if (!lista) return;
    const hechos = new Set(leerHechos(lista.dataset.taller ?? ''));
    lista.querySelectorAll<HTMLElement>('[data-modulo]').forEach((li) => {
      const hecho = hechos.has(Number(li.dataset.modulo));
      li.classList.toggle('hecho', hecho);
      li.querySelector('[data-estado]')!.textContent = hecho ? 'Completado' : 'Pendiente';
    });
  }
  marcarLista();
</script>

<style>
  .cabeza {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--linea);
  }

  .cabeza__fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
    filter: saturate(0.6) hue-rotate(-20deg);
    mask-image: linear-gradient(180deg, #000 30%, transparent);
  }

  .cabeza__contenido {
    position: relative;
    padding-block: 3rem 3.5rem;
  }

  .cabeza__entrada {
    font-size: 1.15rem;
    color: var(--texto-2);
    max-width: 38rem;
  }

  .miga {
    display: table;
    margin-bottom: 1.5rem;
    font-size: 0.92rem;
    color: var(--texto-2);
    text-decoration: none;
  }

  .datos {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .datos li {
    background: rgba(21, 12, 23, 0.85);
    border: 1px solid var(--linea);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.92rem;
    color: var(--texto-2);
  }

  .datos strong {
    color: var(--oro-suave);
    margin-right: 0.35rem;
    font-weight: 700;
  }

  .cuerpo {
    display: grid;
    gap: 2rem;
    padding-top: 3rem;
  }

  @media (min-width: 900px) {
    .cuerpo {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .recorrido__caja {
    display: grid;
    gap: 1.5rem;
  }

  .modulos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .modulos a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--texto);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .modulos a:hover {
    background: rgba(240, 177, 63, 0.06);
    border-color: var(--linea);
  }

  .modulos__marca {
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.15rem;
    border-radius: 6px;
    border: 2px solid var(--linea-fuerte);
    display: grid;
    place-items: center;
  }

  .hecho .modulos__marca {
    background: var(--oro);
    border-color: var(--oro);
  }

  .hecho .modulos__marca::after {
    content: '';
    width: 0.35rem;
    height: 0.65rem;
    border: solid #1a0d05;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }

  .modulos__texto {
    display: grid;
    gap: 0.15rem;
  }

  .modulos__titulo {
    font-weight: 700;
  }

  .modulos__resumen {
    font-size: 0.93rem;
    color: var(--texto-2);
  }

  .modulos__min {
    font-size: 0.85rem;
    color: var(--texto-3);
    white-space: nowrap;
  }

  .lateral {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .lateral {
      margin-top: 3.4rem;
    }
  }

  .lateral__titulo {
    font-size: 1.2rem;
  }

  .lateral__texto {
    color: var(--texto-2);
    margin: 0;
    font-size: 0.98rem;
  }

  .recursos {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.9rem;
  }

  .recursos li {
    display: flex;
    gap: 0.75rem;
    align-items: start;
  }

  .recursos li :global(.estrella) {
    margin-top: 0.25rem;
  }

  .recursos strong {
    display: block;
  }

  .recursos strong a {
    color: var(--oro-suave);
    text-decoration: underline;
    text-decoration-color: var(--linea-fuerte);
    text-underline-offset: 0.2em;
  }

  .recursos strong a:hover {
    color: var(--oro);
  }

  .recursos__detalle {
    font-size: 0.9rem;
    color: var(--texto-2);
  }

  .aviso {
    font-size: 0.85rem;
    color: var(--texto-3);
    border-top: 1px solid var(--linea);
    padding-top: 0.9rem;
    margin: 0;
  }
</style>
